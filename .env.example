# Contact form email delivery (https://resend.com)
# Without these, development logs leads to the server console
# and production shows a "please email us" fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
CONTACT_FROM_EMAIL="NexusAI <hello@yourdomain.com>"

# Public site URL (used for social previews, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# AI chat assistant (https://openrouter.ai). Free NVIDIA Nemotron models by default.
OPENROUTER_API_KEY=
# Optional: comma separated model ids to try in order
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free
